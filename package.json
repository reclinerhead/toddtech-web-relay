{
  "name": "toddtech-web-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted multi-tenant fetch relay: retrieves public web pages from a home connection on behalf of cloud-hosted apps.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "undici": "^7.29.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
