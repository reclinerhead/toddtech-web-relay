# toddtech-web-relay settings. Every knob is optional; the values shown are
# the defaults. On orchid this file is /srv/web-relay/.env and compose loads
# it if present. Timeouts, the body cap, and the redirect cap are fixed by the
# contract (20 s, 5 MiB, 5 hops) and are not configurable.

# Listen address and port. The image sets RELAY_BIND=0.0.0.0 so the bridge
# network can reach it; compose publishes the port on 127.0.0.1 only.
RELAY_PORT=8787
RELAY_BIND=127.0.0.1

# Tenant file, read once at process start. compose mounts the real file at
# /config/tenants.yml and sets this accordingly.
RELAY_TENANTS_FILE=./tenants.yml

# Global per-upstream-host gate: at most one fetch per hostname per interval,
# across every tenant.
RELAY_HOST_MIN_INTERVAL_MS=3000

# Bad-key lockout: this many failed authentications from one source inside
# the window puts that source in cooldown. A valid key is never locked out.
RELAY_LOCKOUT_FAILURES=10
RELAY_LOCKOUT_WINDOW_MS=300000
RELAY_LOCKOUT_COOLDOWN_MS=900000
